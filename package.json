{
    "name": "@guebbit/vue-toolkit",
    "version": "5.0.0",
    "description": "Vue 3 composables and Pinia stores for CRUD screens: a normalized record store, a REST layer built on TanStack Query, Zod-backed form validation, and toast/loading stores.",
    "keywords": [
        "vue",
        "vue3",
        "composables",
        "pinia",
        "tanstack-query",
        "vue-query",
        "crud",
        "rest",
        "forms",
        "validation",
        "zod",
        "typescript"
    ],
    "homepage": "https://guebbit.github.io/vue-toolkit/",
    "bugs": {
        "url": "https://github.com/Guebbit/vue-toolkit/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Guebbit/vue-toolkit.git"
    },
    "license": "AGPL-3.0-only",
    "author": "Guebbit",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "tsc",
        "test": "jest --config jest.config.cjs --passWithNoTests",
        "test:package": "publint --strict && attw --pack . --profile esm-only && node tests/package/smoke.mjs && node tests/package/dtsGuard.mjs",
        "test:types": "tsc -p tsconfig.types.json",
        "test:mutation": "stryker run",
        "test:mutation:incremental": "stryker run --incremental",
        "test:target": "clear && jest --config jest.config.cjs tests/structureRestApi",
        "lint": "eslint \"*/**/*.{ts,js,json}\"",
        "lint:fix": "eslint \"*/**/*.{ts,js,json}\" --fix",
        "prettier": "npx prettier . --check",
        "prettier:fix": "npx prettier . --write",
        "docs:dev": "vitepress dev docs --port 8080",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "update:all": "npx npm-check-updates -u",
        "complete": "npm run lint:fix && npm run prettier:fix && npm run build && npm run test:package && npm run test && npm run test:types && npm run docs:build",
        "complete:check": "npm run lint && npm run prettier && npm run build && npm run test:package && npm run test && npm run test:types && npm run docs:build",
        "check:clean": "node -e \"const s=require('child_process').execSync('git status --porcelain').toString();if(s.trim()){console.error('working tree is not clean — commit or stash before publishing:\\n'+s);process.exit(1)}\"",
        "prepublishOnly": "npm run check:clean && npm run complete:check",
        "publish:public": "npm publish --access public",
        "prepare": "husky"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^9.0.0",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/jest-runner": "^9.6.1",
        "@tanstack/vue-query": "5.103.3",
        "@types/eslint": "^9.6.1",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.57.2",
        "@typescript-eslint/parser": "^8.57.2",
        "@vue/eslint-config-typescript": "^14.7.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-oxlint": "^1.57.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unicorn": "^64.0.0",
        "eslint-plugin-vue": "^10.8.0",
        "expect-type": "^1.4.0",
        "fast-check": "^4.10.2",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.5.2",
        "mermaid": "^11.17.2",
        "pinia": "^3.0.4",
        "prettier": "^3.8.1",
        "publint": "^0.3.24",
        "ts-jest": "^29.4.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.2",
        "vitepress": "^1.6.4",
        "vitepress-plugin-mermaid": "^2.0.17",
        "vue": "^3.5.31"
    },
    "peerDependencies": {
        "@tanstack/vue-query": "^5.103",
        "pinia": "^2.1 || ^3",
        "vue": "^3.4",
        "zod": "^4.4.3"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "dependencies": {
        "@guebbit/js-toolkit": "^2.2.0"
    }
}
