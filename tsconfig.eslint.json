{
    "extends": "./tsconfig.json",
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "tests/**/*.vue",
        "cypress/**/*.ts",
        "cypress.config.ts",
        "vite.config.ts",
        "vitest.config.ts"
    ],
    "compilerOptions": {
        "types": ["vue", "jest", "node"],
        "allowJs": true,
        // Overrides the base config's NodeNext, for the same reason as tsconfig.vitest.json.
        "module": "ESNext",
        "moduleResolution": "bundler"
    }
}
