# Unversioned files and folders.
# References at https://git-scm.com/docs/gitignore.

# IDE files
.idea

# vitepress
.vitepress/dist
.vitepress/cache

# npm run build
dist/
cache/

# Finder's configuration files (Mac).
.DS_Store

# Node.js modules.
node_modules/

# NPM's shrinkwrap.
# We're using `package-lock.json` instead.
npm-shrinkwrap.json

# Yarn's lockfile, Plug'n'Play, folder and settings.
# We're using NPM and it provide its own lockfile and settings.
yarn.lock
.pnp.*
.yarn/
.yarnrc
.yarnrc.yaml

# PNPM's lockfile, workspaces and hooks.
# We're using NPM and it provide its own lockfile and settings.
pnpm-lock.yaml
pnpm-workspaces.yaml
pnpmfile.js

# Log's files.
*.log
*.log.*

# Stryker mutation testing artifacts.
.stryker-tmp/
reports/

# Claude Code's local state: session settings, and the worktrees it creates under
# `.claude/worktrees/` — which `jest.config.cjs` excludes from every test run. None of it describes
# the project, so none of it is shared. `commands/`, `agents/` and `skills/` stay un-ignored as the
# places a project-wide slash command, agent or skill would be checked in.
/.claude/*
!/.claude/commands/
!/.claude/agents/
!/.claude/skills/

# 2brain:start — regenerate with: 2brain <repo-path>
.2brain/graphify-out/cache/
.2brain/graphify-out/graph.json
.2brain/graphify-out/manifest.json
.2brain/graphify-out/.graphify_analysis.json
.2brain/graphify-out/.graphify_labels.json*
.2brain/graphify-out/graph.html
.2brain/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
.2brain/modules/.modules-cache.json
.2brain/repo-index.json
.codeboarding/
# 2brain:end
