# Unversioned files and folders.
# References at https://git-scm.com/docs/gitignore.

# IDE files
.idea

# vitepress
.vitepress/dist
.vitepress/cache

# npm run build
dist/
cache/

# Finder's configuration files (Mac).
.DS_Store

# Node.js modules.
node_modules/

# NPM's shrinkwrap.
# We're using `package-lock.json` instead.
npm-shrinkwrap.json

# Yarn's lockfile, Plug'n'Play, folder and settings.
# We're using NPM and it provide its own lockfile and settings.
yarn.lock
.pnp.*
.yarn/
.yarnrc
.yarnrc.yaml

# PNPM's lockfile, workspaces and hooks.
# We're using NPM and it provide its own lockfile and settings.
pnpm-lock.yaml
pnpm-workspaces.yaml
pnpmfile.js

# Log's files.
*.log
*.log.*

# Stryker mutation testing artifacts.
.stryker-tmp/
reports/

# Claude Code's local state: session settings, and the worktrees it creates under
# `.claude/worktrees/` — which `jest.config.js` already excludes from every test run. None of it
# describes the project, so none of it is shared. `commands/` is un-ignored as a place a project
# slash command COULD be checked in — nothing is right now, since the only thing that would live
# there today (the `audit` symlink, below) is excluded on purpose.
/.claude/*
!/.claude/commands/
!/.claude/agents/
!/.claude/skills/
